        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(zfs_pool_health{pool=\"zstore\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ONLINE",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "DEGRADED",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "FAULTED",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "OFFLINE",
                  "color": "red",
                  "index": 3
                },
                "4": {
                  "text": "UNAVAIL",
                  "color": "red",
                  "index": 4
                },
                "5": {
                  "text": "REMOVED",
                  "color": "red",
                  "index": 5
                },
                "6": {
                  "text": "SUSPENDED",
                  "color": "red",
                  "index": 6
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO DATA",
                  "color": "red",
                  "index": 7
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
