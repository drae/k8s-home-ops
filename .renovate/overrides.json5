{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Ignore shell variables picked up by the presets' oci:// matcher in workflow scripts",
      matchDepNames: ["/^\\$\\{/"],
      enabled: false,
    },
    {
      description: "Talos templates are versioned through infrastructure/talos/*/version.yaml",
      matchFileNames: ["infrastructure/talos/**/*.j2"],
      enabled: false,
    },
    {
      description: "Ansible Galaxy commit scope",
      matchDatasources: ["galaxy", "galaxy-collection"],
      semanticCommitScope: "ansible",
    },
  ],
}
