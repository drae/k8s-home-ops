{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      description: "Process Kubernetes image volume references",
      managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        // reference: ghcr.io/siderolabs/talosctl:v1.14.2@sha256:...
        "reference:\\s*[\"']?(?<depName>[^\\s:@\"']+):(?<currentValue>[^\\s@\"']+)(@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
      datasourceTemplate: "docker",
    },
    {
      // The home-operations grafanaDashboards preset only scans grafanadashboard.yaml (Grafana
      // Operator CRs); this covers dashboard URLs in the standalone Grafana chart's HelmRelease
      customType: "regex",
      description: "Process Grafana dashboards in HelmRelease values",
      managerFilePatterns: ["/(^|/)helmrelease\\.ya?ml$/"],
      matchStrings: [
        "dashboards\\/(?<depName>\\d+)\\/revisions\\/(?<currentValue>\\d+)\\/download",
      ],
      datasourceTemplate: "custom.grafana-dashboards",
      versioningTemplate: "regex:^(?<major>\\d+)$",
      autoReplaceStringTemplate: "dashboards/{{depName}}/revisions/{{newValue}}/download",
    },
  ],
}
